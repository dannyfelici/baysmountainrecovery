{
  // Cloudflare Workers config — serves the static Astro build from ./dist
  "name": "blueridgebehavioralhealth",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  }
  // Add the custom domain (blueridgebhtn.com) under "routes" once DNS is on Cloudflare.
}
