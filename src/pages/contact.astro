---
import BaseLayout from '../layouts/BaseLayout.astro';
import TornEdge from '../components/TornEdge.astro';
import { site, mapEmbed } from '../data/site';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Contact', item: `${site.url}/contact/` },
    ],
  },
];
---

<BaseLayout
  title="Contact Bays Mountain Recovery | Kingsport, TN"
  description="Have questions about addiction treatment in Kingsport, TN? Contact our team to learn about medical detox, residential care, and your next steps."
  schema={schema}
>
  <section class="page-hero">
    <img src="/images/kingsport-downtown.jpg" alt="" />
    <div class="container page-hero-inner">
      <div class="page-hero-copy">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <ol><li><a href="/">Home</a></li><li><span aria-current="page">Contact</span></li></ol>
        </nav>
        <p class="eyebrow">Contact Us</p>
        <h1>Contact Bays Mountain Recovery</h1>
        <p class="lede">Taking the first step toward addiction treatment can bring up a lot of questions. You may be worried about withdrawal, uncertain about what treatment involves, or simply wondering where to begin. Whatever your circumstances, we're here to listen, answer your questions, and help you explore your options. Whether you're seeking help for yourself or someone you love, reaching out is a meaningful first step toward recovery.</p>
        <p>Call us at <a href={site.phoneHref}>{site.phone}</a> or complete the contact form below to get started.</p>
      </div>
    </div>
    <TornEdge position="bottom" />
  </section>

  <section class="container section--tight" style="padding-bottom: var(--section)">
    <div class="contact-grid">
      <!-- TODO: connect to the CTM FormReactor before launch. Keep the form free of tracking pixels (HIPAA). -->
      <form class="contact-form" method="post" action="#" data-ctm-form="contact">
        <h2 style="font-size: 1.5rem; margin: 0">Send us a message</h2>
        <div class="row">
          <label>First name<input type="text" name="first_name" autocomplete="given-name" required /></label>
          <label>Last name<input type="text" name="last_name" autocomplete="family-name" required /></label>
        </div>
        <div class="row">
          <label>Phone<input type="tel" name="phone" autocomplete="tel" required /></label>
          <label>Email<input type="email" name="email" autocomplete="email" /></label>
        </div>
        <label>Who is treatment for?
          <select name="for_whom">
            <option>Myself</option>
            <option>A loved one</option>
            <option>A client or patient</option>
          </select>
        </label>
        <label>How can we help?<textarea name="message"></textarea></label>
        <p class="fine">Please don't include detailed medical information. Our admissions team will follow up by phone.</p>
        <button class="btn" type="submit">Send message</button>
      </form>
      <aside class="contact-aside">
        <div class="card">
          <h3>Call admissions</h3>
          <p>Talk with our team about medical detox, residential treatment, and insurance.</p>
          <a class="btn" href={site.phoneHref}>Call {site.phone}</a>
        </div>
        <div class="card">
          <h3>Visit us</h3>
          <address>
            {site.name}<br />
            {site.address.street}<br />
            {site.address.city}, {site.address.state} {site.address.zip}
          </address>
        </div>
      </aside>
    </div>
    <div class="map-embed">
      <iframe title="Map to Bays Mountain Recovery, 2000 Greenway Street, Kingsport, TN" src={mapEmbed} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </section>
</BaseLayout>
