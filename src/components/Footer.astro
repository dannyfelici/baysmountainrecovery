---
import { site, nav } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div>
      <p class="footer-name">{site.name}</p>
      <address>
        {site.address.street}<br />
        {site.address.city}, {site.address.state} {site.address.zip}<br />
        <a href={site.phoneHref}>{site.phone}</a>
      </address>
    </div>
    <ul class="footer-nav">
      {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
    </ul>
  </div>
  <div class="container legal">
    <p>&copy; {year} {site.name}. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer { background: var(--color-primary-dark); color: #fff; padding-block: 3rem 1.5rem; margin-top: var(--space-section); }
  .site-footer a { color: #fff; }
  .footer-inner { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 2rem; }
  .footer-name { font-family: var(--font-heading); font-size: 1.25rem; margin: 0 0 0.5rem; }
  address { font-style: normal; }
  .footer-nav { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.4rem; }
  .legal { margin-top: 2rem; font-size: 0.875rem; opacity: 0.8; }
</style>
