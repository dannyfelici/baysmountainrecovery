---
import { site, nav } from '../data/site';

const current = Astro.url.pathname;
const isCurrent = (href: string) => current === href || (href !== '/' && current.startsWith(href));
const caret = '<svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5 L5 6.5 L8 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>';
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo" aria-label={`${site.name} home`}>
      <img src="/images/bays-mountain-recovery-horizontal.svg" alt={site.name} width="260" height="56" />
    </a>
    <nav class="main-nav" aria-label="Main">
      <ul>
        {nav.map((item) => (
          <li class:list={{ 'has-menu': item.children }}>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}{item.children && <Fragment set:html={caret} />}
            </a>
            {item.children && (
              <ul class="dropdown">
                {item.children.map((c) => (
                  <li><a href={c.href} aria-current={current === c.href ? 'page' : undefined}>{c.label}</a></li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
    <div class="header-ctas">
      <a class="btn" href={site.phoneHref}>{site.phone}</a>
    </div>
    <details class="mobile-nav">
      <summary>Menu</summary>
      <div class="mobile-panel">
        {nav.map((item) => (
          <>
            <a href={item.href}>{item.label}</a>
            {item.children && (
              <div class="mobile-sub">
                {item.children.map((c) => <a href={c.href}>{c.label}</a>)}
              </div>
            )}
          </>
        ))}
        <a class="btn" href={site.phoneHref}>Call {site.phone}</a>
      </div>
    </details>
  </div>
</header>
