---
import { site, nav } from '../data/site';

interface Props { solid?: boolean }
const { solid = true } = Astro.props;
const current = Astro.url.pathname;
const isCurrent = (href: string) => current === href || (href !== '/' && current.startsWith(href));
---

<header class:list={['site-header', { 'site-header--solid': solid }]}>
  <div class="container header-inner">
    <a href="/" class="logo" aria-label={`${site.name} home`}>
      <img src="/images/bays-mountain-recovery-horizontal.svg" alt={site.name} width="260" height="56" />
    </a>
    <nav class="main-nav" aria-label="Main">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="header-ctas">
      <a class="btn-outline" href={site.phoneHref}>{site.phone}</a>
      <a class="btn" href="/contact/">Verify Insurance</a>
    </div>
    <details class="mobile-nav">
      <summary>Menu</summary>
      <div class="mobile-panel">
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        <a class="btn" href={site.phoneHref}>Call {site.phone}</a>
      </div>
    </details>
  </div>
</header>
